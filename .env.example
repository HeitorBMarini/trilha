# Crie um app em https://developer.spotify.com/dashboard e copie as credenciais.
# Sem estas variáveis o site funciona só no modo demonstração.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Precisa ser idêntica a uma das Redirect URIs cadastradas no app do Spotify.
# Local: o Spotify não aceita "localhost", use o IP 127.0.0.1.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:3009/api/auth/callback
